datasource db { provider = "postgresql"; url = env("MENU_DATABASE_URL") }
generator client { provider = "prisma-client-js" }
model MenuItem { id String @id @default(uuid()); restaurantId String; name String; description String?; price Decimal @db.Decimal(10,2); isAvailable Boolean @default(true); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
