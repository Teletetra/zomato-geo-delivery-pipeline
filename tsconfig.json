{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@app/*": ["apps/*/src/*"],
      "@common/*": ["libs/common/src/*"],
      "@kafka/*": ["libs/kafka/src/*"],
      "@redis/*": ["libs/redis/src/*"],
      "@auth/*": ["libs/auth/src/*"]
    }
  }
}
